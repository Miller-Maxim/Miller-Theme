<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Cg fill='%23FF8FA3'%3E%3Cpath d='M50 50 Q35 30 20 35 Q30 50 50 50 Z'/%3E%3Cpath d='M50 50 Q70 35 80 35 Q70 50 50 50 Z' transform='rotate(72 50 50)'/%3E%3Cpath d='M50 50 Q70 35 80 35 Q70 50 50 50 Z' transform='rotate(144 50 50)'/%3E%3Cpath d='M50 50 Q70 35 80 35 Q70 50 50 50 Z' transform='rotate(216 50 50)'/%3E%3Cpath d='M50 50 Q70 35 80 35 Q70 50 50 50 Z' transform='rotate(288 50 50)'/%3E%3C/g%3E%3Ccircle cx='50' cy='50' r='6' fill='%23FFD0DC'/%3E%3C/svg%3E">
    <title><%= page.title || config.title %></title>
    <%- css('css/style.css') %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body>
    <div class="sakura-falling" aria-hidden="true">
        <span class="petal"></span><span class="petal"></span><span class="petal"></span>
        <span class="petal"></span><span class="petal"></span><span class="petal"></span>
    </div>

    <header>
        <div class="container">
            <div class="header-inner">
                <a href="<%- url_for() %>" class="brand">
                    <span class="logo-sakura">❀</span>
                    <span class="brand-title"><%= config.title %></span>
                </a>
                <nav class="nav-links">
                    <a href="<%- url_for() %>" class="nav-link <% if(page.path === 'index.html' || page.path === '') { %>active<% } %>">Home</a>
                    <% if (site.categories.length) { %>
                        <a href="<%- url_for('categories') %>" class="nav-link">Categories</a>
                    <% } %>
                    <a href="https://github.com/Miller-Maxim" target="_blank" class="nav-link" title="GitHub">
                        <i class="fab fa-github"></i>
                    </a>
                    <a href="mailto:<%= config.email || 'miller-maxim@example.com' %>" class="nav-link" title="Email">
                        <i class="fas fa-envelope"></i>
                    </a>
                </nav>
                <button class="nav-toggle" aria-label="Toggle menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
            <nav class="nav-mobile">
                <a href="<%- url_for() %>" class="nav-link <% if(page.path === 'index.html' || page.path === '') { %>active<% } %>">Home</a>
                <% if (site.categories.length) { %>
                    <a href="<%- url_for('categories') %>" class="nav-link">Categories</a>
                <% } %>
                <a href="https://github.com/Miller-Maxim" target="_blank" class="nav-link" title="GitHub">GitHub</a>
                <a href="mailto:<%= config.email || 'miller-maxim@example.com' %>" class="nav-link" title="Email">Email</a>
            </nav>
        </div>
    </header>

    <main class="container">
        <%- body %>
    </main>

    <footer>
        <div class="container">
            <p>&copy; <%= date(new Date(), 'YYYY') %> <%= config.author %> · <a href="https://github.com/Miller-Maxim/Miller-Theme" target="_blank">Miller Theme</a></p>
        </div>
    </footer>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var codeEls = document.querySelectorAll('pre > code.hljs');
            codeEls.forEach(function(codeEl) {
                var pre = codeEl.parentElement;
                var wrapper = document.createElement('div');
                wrapper.className = 'code-block';
                pre.parentNode.insertBefore(wrapper, pre);

                var divider = document.createElement('div');
                divider.className = 'code-divider';
                wrapper.appendChild(divider);

                wrapper.appendChild(pre);

                var lang = '';
                if (codeEl.className) {
                    var match = codeEl.className.match(/language-(\w+)/);
                    if (match) lang = match[1].toUpperCase();
                }
                if (!lang && codeEl.className) {
                    var match2 = codeEl.className.match(/hljs\s+(\w+)/);
                    if (match2) lang = match2[1].toUpperCase();
                }
                if (lang) {
                    var label = document.createElement('span');
                    label.className = 'code-lang-label';
                    label.textContent = lang;
                    wrapper.appendChild(label);
                }
                var btn = document.createElement('button');
                btn.className = 'code-copy-btn';
                btn.textContent = 'Copy';
                btn.addEventListener('click', function() {
                    var text = codeEl.textContent;
                    var ta = document.createElement('textarea');
                    ta.value = text;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.select();
                    try {
                        document.execCommand('copy');
                        btn.textContent = 'Copied!';
                        btn.classList.add('copied');
                        setTimeout(function() { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
                    } catch(e) {}
                    document.body.removeChild(ta);
                });
                wrapper.appendChild(btn);
            });

            var header = document.querySelector('header');
            var onScroll = function() {
                if (window.scrollY > 10) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();

            var toggle = document.querySelector('.nav-toggle');
            var mobileNav = document.querySelector('.nav-mobile');
            if (toggle && mobileNav) {
                toggle.addEventListener('click', function() {
                    toggle.classList.toggle('active');
                    mobileNav.classList.toggle('open');
                });
                mobileNav.querySelectorAll('.nav-link').forEach(function(link) {
                    link.addEventListener('click', function() {
                        toggle.classList.remove('active');
                        mobileNav.classList.remove('open');
                    });
                });
            }
        });
    </script>
</body>
</html>
